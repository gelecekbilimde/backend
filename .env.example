# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env dosyası git'e eklenmez.
# Gerçek anahtarları asla repoya commit'lemeyin; canlı ortamda GitHub Secrets veya sunucu ortam değişkenlerini kullanın.

DATABASE_USER=gelecekbilimde
DATABASE_PASSWORD=gelecekbilimdepass

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

FRONT_END_URL=http://localhost:3000
# Virgülle ayrılmış izinli origin listesi
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:2000

# JWT anahtar çifti (dosya yolları). Yeni anahtar üretmek için:
#   openssl genpkey -algorithm RSA -out private.key -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.key -pubout -out public.key
PRIVATE_KEY_PATH=src/main/resources/certs/private.key
PUBLIC_KEY_PATH=src/main/resources/certs/public.key

# Firebase service account JSON dosyasının yolu (boş bırakılırsa push bildirimleri devre dışı kalır)
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_DATABASE_URL=

# Boş bırakılırsa YouTube yeni video bildirimleri devre dışı kalır
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_PLAYLIST_ID=UU03cpKIZShIWoSBhfVE5bog
